@model ezgi_mobilya.Service.DTOs.ProductDto
@{
    ViewData["Title"] = "Yeni Ürün Ekle";
    Layout = "~/Views/Shared/_Layout.Admin.cshtml";
    var categories = ViewBag.Categories as IEnumerable<ezgi_mobilya.Service.DTOs.CategoryDto> ?? new List<ezgi_mobilya.Service.DTOs.CategoryDto>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 style="font-weight: 700;">
        <a href="/Admin/Products" class="btn btn-outline-secondary mr-3" title="Geri Dön">
            <i class="fas fa-arrow-left"></i>
        </a>
        <i class="fas fa-plus-circle mr-2" style="color: var(--color-primary);"></i> Yeni Ürün Ekle
    </h2>
</div>

<div class="admin-card">
    <form asp-action="CreateProduct" asp-controller="Admin" method="post" enctype="multipart/form-data" class="text-left">
        @Html.AntiForgeryToken()
        
        <div class="row">
            <div class="col-md-8">
                <div class="form-group mb-4">
                    <label asp-for="Name" class="font-weight-bold" style="color: var(--text-primary);">Ürün Adı *</label>
                    <input asp-for="Name" class="form-control" required placeholder="Örn: Doğal Ahşap Yemek Masası" style="background-color: var(--bg-secondary); color: var(--text-primary); border: 1px solid var(--color-border);" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Description" class="font-weight-bold" style="color: var(--text-primary);">Açıklama</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Ürün hakkında detaylı bilgi giriniz..." style="background-color: var(--bg-secondary); color: var(--text-primary); border: 1px solid var(--color-border);"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-group mb-4">
                    <label asp-for="CategoryId" class="font-weight-bold" style="color: var(--text-primary);">Kategori *</label>
                    <select asp-for="CategoryId" class="form-control" required style="background-color: var(--bg-secondary); color: var(--text-primary); border: 1px solid var(--color-border);">
                        <option value="">-- Kategori Seçin --</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Price" class="font-weight-bold" style="color: var(--text-primary);">Fiyat (TL) *</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" required placeholder="0.00" style="background-color: var(--bg-secondary); color: var(--text-primary); border: 1px solid var(--color-border);" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>

                <div class="form-group mb-4">
                    <label class="font-weight-bold" style="color: var(--text-primary);">Ürün Görseli</label>
                    <div class="custom-file">
                        <input type="file" class="custom-file-input" id="imageFile" name="imageFile" accept="image/*" onchange="previewImage(this);">
                        <label class="custom-file-label" for="imageFile" style="background-color: var(--bg-secondary); color: var(--text-secondary); border: 1px solid var(--color-border);">Görsel Seç...</label>
                    </div>
                    <small class="form-text text-muted mt-2">Önerilen boyut: 800x500 piksel. PNG, JPG veya WEBP formatında olmalıdır.</small>
                    
                    <div class="mt-3 text-center">
                        <img id="imgPreview" src="/themes/infinite-loop/img/toy-gallery-thumb-01.jpg" class="img-fluid rounded border shadow-sm" style="max-height: 150px; display: none;" alt="Önizleme" />
                    </div>
                </div>

                <div class="form-group mb-4">
                    <div class="custom-control custom-switch">
                        <input asp-for="IsActive" type="checkbox" class="custom-control-input" id="IsActiveSwitch">
                        <label class="custom-control-label font-weight-bold" for="IsActiveSwitch" style="color: var(--text-primary); cursor: pointer;">Ürün Aktif Olsun (Vitrinde Gösterilsin)</label>
                    </div>
                </div>
            </div>
        </div>

        <hr style="border-top: 1px solid var(--color-border);" class="my-4" />

        <div class="d-flex justify-content-end">
            <a href="/Admin/Products" class="btn btn-outline-secondary px-4 py-2 mr-3">İptal</a>
            <button type="submit" class="btn btn-success px-5 py-2">
                <i class="fas fa-save mr-1"></i> Ürünü Kaydet
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function previewImage(input) {
            var file = input.files[0];
            if (file) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    $('#imgPreview').attr('src', e.target.result).show();
                }
                reader.readAsDataURL(file);
                $(input).next('.custom-file-label').html(file.name);
            }
        }
    </script>
}
