@model IEnumerable<ezgi_mobilya.Service.DTOs.ProductDto>
@{
    ViewData["Title"] = "Ürün Listesi";
    Layout = "~/Views/Shared/_Layout.Admin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 style="font-weight: 700;"><i class="fas fa-boxes mr-2" style="color: var(--color-primary);"></i> Atölye Ürünlerimiz</h2>
    <div>
        <a href="/Admin/CreateProduct" class="btn btn-success mr-2">
            <i class="fas fa-plus mr-1"></i> Yeni Ürün Ekle
        </a>
        <a href="/#gallery" target="_blank" class="btn btn-primary tm-btn-primary">
            <i class="fas fa-eye mr-1"></i> Vitrinde Gör
        </a>
    </div>
</div>

<div class="admin-card">
    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th style="width: 80px;">Görsel</th>
                        <th>Ürün Adı</th>
                        <th>Kategori</th>
                        <th>Fiyat</th>
                        <th>Durum</th>
                        <th style="width: 150px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>
                                @{
                                    var adminThumbUrl = product.ThumbnailUrl ?? "";
                                    var isAdminExternalThumb = adminThumbUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || adminThumbUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase);
                                    var finalAdminThumbUrl = isAdminExternalThumb ? adminThumbUrl : Url.Content("~/" + adminThumbUrl);
                                }
                                <img src="@finalAdminThumbUrl" class="img-fluid rounded border shadow-sm" style="max-width: 60px; max-height: 60px; object-fit: cover;" alt="@product.Name" />
                            </td>
                            <td>
                                <strong style="color: var(--text-primary);">@product.Name</strong>
                                <p class="text-muted small mb-0">@product.Description</p>
                            </td>
                            <td>
                                <span class="badge badge-secondary" style="background-color: var(--bg-secondary); color: var(--text-primary); border: 1px solid var(--color-border);">
                                    @product.CategoryName
                                </span>
                            </td>
                            <td><strong style="color: var(--color-primary);">@product.Price.ToString("C2", new System.Globalization.CultureInfo("tr-TR"))</strong></td>
                            <td>
                                @if (product.IsActive)
                                {
                                    <span class="badge badge-success" style="background-color: #28a745;"><i class="fas fa-check-circle mr-1"></i> Aktif</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary" style="background-color: #6c757d;"><i class="fas fa-pause-circle mr-1"></i> Pasif</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <a href="/Admin/EditProduct/@product.Id" class="btn btn-sm btn-outline-primary mr-2" title="Düzenle">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="DeleteProduct" asp-controller="Admin" method="post" onsubmit="return confirm('Bu ürünü silmek istediğinizden emin misiniz?');" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@product.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Sil">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-center py-5 text-muted mb-0">Atölyeye kayıtlı ürün bulunmamaktadır.</p>
    }
</div>
