@model ezgi_mobilya.Web.Controllers.LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ezgi Craft Giriş</title>
    <link rel="stylesheet" href="~/themes/infinite-loop/fontawesome-5.5/css/all.min.css" />
    <link rel="stylesheet" href="~/themes/infinite-loop/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/ezgi-craft-theme.css" />
    <script>
      (function() {
        var savedTheme = localStorage.getItem('ezgi-craft-theme') || 'light';
        document.documentElement.setAttribute('data-theme', savedTheme);
      })();
    </script>
    <style>
        body {
            background-color: var(--bg-primary);
            color: var(--text-primary);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-card {
            background-color: var(--bg-card);
            border: 1px solid var(--color-border);
            border-radius: 8px;
            padding: 40px;
            box-shadow: 0 10px 30px var(--shadow-hover);
            width: 100%;
            max-width: 450px;
        }
        .login-brand {
            color: var(--color-primary);
            font-weight: 800;
            font-size: 2rem;
            letter-spacing: 1px;
            text-align: center;
            margin-bottom: 30px;
        }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="login-brand text-uppercase">
            <i class="fas fa-hammer mr-2"></i> Ezgi Craft
        </div>
        
        <h3 class="h5 mb-4 text-center text-muted" style="font-weight: 600;">Yönetim Paneli Girişi</h3>
        
        <form asp-action="Login" asp-controller="Account" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            @Html.AntiForgeryToken()
            
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="font-weight-bold small text-muted">E-posta Adresi</label>
                <input asp-for="Email" class="form-control" placeholder="admin@ezgicraft.com" style="padding: 12px 15px; border-radius: 4px;" required />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Password" class="font-weight-bold small text-muted">Şifre</label>
                <input asp-for="Password" class="form-control" placeholder="••••••••" style="padding: 12px 15px; border-radius: 4px;" required />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="form-group form-check mb-4 d-flex justify-content-between align-items-center">
                <div>
                    <input asp-for="RememberMe" class="form-check-input" id="RememberMe" />
                    <label class="form-check-label small text-muted font-weight-bold" for="RememberMe">Beni Hatırla</label>
                </div>
                <a href="/" class="small text-muted"><i class="fas fa-arrow-left mr-1"></i> Siteye Dön</a>
            </div>

            <button type="submit" class="btn btn-primary tm-btn-primary btn-block py-3 font-weight-bold text-uppercase w-100" style="letter-spacing: 1px; border-radius: 4px !important;">Giriş Yap</button>
        </form>
    </div>

</body>
</html>
