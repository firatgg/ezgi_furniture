    <!-- Contact -->
    <section id="contact" class="tm-section-pad-top tm-parallax-2">
    
      <div class="container tm-container-contact">
        
        <div class="row">
            
            <div class="text-center col-12">
                <h2 class="tm-section-title mb-4">Bize Ulaşın</h2>
                <p class="mb-5">
                  Herhangi bir sorunuz, öneriniz veya projeniz için bizimle iletişime geçmekten çekinmeyin. Size yardımcı olmaktan mutluluk duyarız.
                </p><br>
            </div>
            
            <div class="col-sm-12 col-md-6">
              <form action="" method="get">
                <input id="name" name="name" type="text" placeholder="Adınız" class="tm-input" required />
                <input id="email" name="email" type="email" placeholder="E-posta Adresiniz" class="tm-input" required />
                <textarea id="message" name="message" rows="8" placeholder="Mesajınız" class="tm-input" required></textarea>
                <button type="submit" class="btn tm-btn-submit">Gönder</button>
              </form>
            </div>
            
            <div class="col-sm-12 col-md-6">

                <div class="contact-item">
                  <a rel="nofollow" href="#" class="item-link">
