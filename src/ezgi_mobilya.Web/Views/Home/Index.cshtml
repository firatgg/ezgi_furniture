@model IEnumerable<ezgi_mobilya.Service.DTOs.ProductDto>
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = Localizer["Nav_Home"];
    Layout = "~/Views/Shared/_Layout.InfiniteLoop.cshtml";

    var instagramUrl = Configuration["SiteContact:InstagramUrl"];
    var instagramLabel = Configuration["SiteContact:InstagramLabel"];
    var whatsappUrl = Configuration["SiteContact:WhatsAppUrl"];
    var whatsappLabel = Configuration["SiteContact:WhatsAppLabel"];
    var email = Configuration["SiteContact:Email"];
    var phoneUrl = Configuration["SiteContact:PhoneUrl"];
    var phoneLabel = Configuration["SiteContact:PhoneLabel"];
    var addressLabel = Configuration["SiteContact:AddressLabel"];

    var hasInstagram = !string.IsNullOrWhiteSpace(instagramUrl) && !string.IsNullOrWhiteSpace(instagramLabel);
    var hasWhatsApp = !string.IsNullOrWhiteSpace(whatsappUrl) && !string.IsNullOrWhiteSpace(whatsappLabel);
    var hasEmail = !string.IsNullOrWhiteSpace(email);
    var hasPhone = !string.IsNullOrWhiteSpace(phoneUrl) && !string.IsNullOrWhiteSpace(phoneLabel);
    var hasAddress = !string.IsNullOrWhiteSpace(addressLabel);
    var hasAnyContact = hasInstagram || hasWhatsApp || hasEmail || hasPhone || hasAddress;

    string ToWebpPath(string path)
    {
        if (string.IsNullOrWhiteSpace(path)) return path;
        if (path.EndsWith(".png", StringComparison.OrdinalIgnoreCase))
            return path[..^4] + ".webp";
        if (path.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) || path.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase))
            return System.IO.Path.ChangeExtension(path, ".webp") ?? path;
        return path;
    }

    string ToThumbWebpPath(string path)
    {
        if (string.IsNullOrWhiteSpace(path)) return path;
        var webp = ToWebpPath(path);
        var slash = webp.LastIndexOf('/');
        var file = slash >= 0 ? webp[(slash + 1)..] : webp;
        var dir = slash >= 0 ? webp[..(slash + 1)] : "";
        if (file.EndsWith(".webp", StringComparison.OrdinalIgnoreCase) && !file.Contains("-thumb.", StringComparison.OrdinalIgnoreCase))
            file = file[..^5] + "-thumb.webp";
        return dir + file;
    }
}

