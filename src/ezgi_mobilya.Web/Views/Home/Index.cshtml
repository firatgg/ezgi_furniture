<!-- Koleksiyonumuz Section -->
<section id="gallery" class="tm-section-pad-top">
  <div class="container">
    <div class="row">
      <div class="text-center col-lg-10 offset-lg-1 mb-5">
        <span class="tm-section-subtitle-badge">@Localizer["Gallery_Header"]</span>
        <h2 class="tm-section-title tm-serif-title mb-4">@Localizer["Gallery_Title"]</h2>
        <p class="mx-auto tm-section-desc text-muted">
          @Localizer["Gallery_Desc"]
        </p>
      </div>
    </div>
    <div class="row">
      <div class="col-12">
        <div class="mx-auto tm-gallery-container">
          <div class="grid tm-gallery">
            @if (Model != null && Model.Any())
            {
              @foreach (var product in Model)
              {
                <div class="tm-gallery-card-wrapper px-2">
                  @{
                      var imageUrl = product.ImageUrl ?? "";
                      var isExternalImage = imageUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || imageUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase);
                      var optimizedImagePath = isExternalImage ? imageUrl : ToWebpPath(imageUrl);
                      var finalImageUrl = isExternalImage ? imageUrl : Url.Content("~/" + optimizedImagePath);
                      
                      var thumbnailUrl = product.ThumbnailUrl ?? imageUrl;
                      var isExternalThumb = thumbnailUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || thumbnailUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase);
                      var thumbWebpPath = isExternalThumb ? thumbnailUrl : ToThumbWebpPath(thumbnailUrl);
                      var thumbFallbackPath = isExternalThumb ? thumbnailUrl : thumbnailUrl;
                      var finalThumbnailWebp = isExternalThumb ? null : Url.Content("~/" + thumbWebpPath);
                      var finalThumbnailUrl = isExternalThumb ? thumbnailUrl : Url.Content("~/" + thumbFallbackPath);
                  }
                  <a href="@finalImageUrl" class="tm-gallery-card-link">
                    <div class="tm-gallery-card">
                      <div class="tm-gallery-img-container">
                        <picture>
                          @if (finalThumbnailWebp != null)
                          {
                            <source srcset="@finalThumbnailWebp" type="image/webp" />
                          }
                          <img src="@finalThumbnailUrl" alt="@Localizer[product.Name]" class="img-fluid tm-gallery-img" width="640" height="360" loading="lazy" decoding="async">
                        </picture>
                      </div>
                      <div class="tm-gallery-card-info mt-3 text-left">
                        <span class="tm-gallery-card-category text-uppercase small font-weight-bold">@Localizer[product.CategoryName ?? ""]</span>
                        <h3 class="tm-gallery-card-title my-1 font-weight-bold tm-serif-title">@Localizer[product.Name]</h3>
                      </div>
                    </div>
                  </a>
                </div>
              }
            }
            else
            {
              <p class="text-center text-muted w-100 py-5">@Localizer["Gallery_Empty"]</p>
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Sipariş & İletişim Section -->
<section id="contact" class="tm-section-pad-top tm-parallax-2">
  <div class="container tm-container-contact">
    <div class="row">
      <div class="text-center col-12">
        <h2 class="tm-section-title tm-serif-title mb-4">@Localizer["Contact_Title"]</h2>
        <p class="mb-5 text-white">
          @Localizer["Contact_Intro"]
        </p>
      </div>
    </div>

    <div class="row">
      <!-- Contact Info Section -->
      <div class="col-sm-12 col-md-5 d-flex flex-column justify-content-start mb-5 mb-md-0 text-white">
        <h3 class="mb-4 text-white h4 tm-serif-title">@Localizer["Contact_InfoTitle"]</h3>
        
        <div class="tm-contact-info-list">
          @if (hasInstagram)
          {
            <a rel="nofollow noopener noreferrer" href="@instagramUrl" target="_blank" class="tm-contact-item">
              <div class="tm-contact-icon-wrapper">
                <i class="fab fa-instagram tm-contact-icon tm-icon-instagram"></i>
              </div>
              <span class="tm-contact-text">@instagramLabel</span>
            </a>
          }

          @if (hasWhatsApp)
          {
            <a rel="nofollow noopener noreferrer" href="@whatsappUrl" target="_blank" class="tm-contact-item">
              <div class="tm-contact-icon-wrapper">
                <i class="fab fa-whatsapp tm-contact-icon tm-icon-whatsapp"></i>
              </div>
              <span class="tm-contact-text">@whatsappLabel</span>
            </a>
          }

          @if (hasPhone)
          {
            <a rel="nofollow" href="@phoneUrl" class="tm-contact-item">
              <div class="tm-contact-icon-wrapper">
                <i class="fas fa-phone tm-contact-icon tm-icon-phone"></i>
              </div>
              <span class="tm-contact-text">@phoneLabel</span>
            </a>
          }

          @if (hasEmail)
          {
            <a rel="nofollow" href="mailto:@email" class="tm-contact-item">
              <div class="tm-contact-icon-wrapper">
                <i class="far fa-envelope tm-contact-icon tm-icon-email"></i>
              </div>
              <span class="tm-contact-text">@email</span>
            </a>
          }

          @if (hasAddress)
          {
            <div class="tm-contact-item">
              <div class="tm-contact-icon-wrapper">
                <i class="fas fa-map-marker-alt tm-contact-icon tm-icon-address"></i>
              </div>
              <span class="tm-contact-text">@addressLabel</span>
            </div>
          }

          @if (!hasAnyContact)
          {
            <p class="text-white-50">@Localizer["Contact_NoChannels"]</p>
          }
        </div>
      </div>

      <!-- Interactive Form Section -->
      <div class="col-sm-12 col-md-7">
        <div class="bg-white p-4 rounded shadow tm-contact-form-container">
          <h3 class="tm-text-primary mb-4 text-center h4 font-weight-bold tm-serif-title">@Localizer["Contact_FormTitle"]</h3>
          
          @if (TempData["SuccessMessage"] != null)
          {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
              <i class="fas fa-check-circle mr-2"></i> @TempData["SuccessMessage"]
            </div>
          }
          
          @if (TempData["ErrorMessage"] != null)
          {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
              <i class="fas fa-exclamation-circle mr-2"></i> @TempData["ErrorMessage"]
            </div>
          }

          <form asp-action="SubmitContactMessage" asp-controller="Home" method="post" class="text-left tm-minimal-form">
            @Html.AntiForgeryToken()
            <div class="form-group mb-4">
              <input type="text" class="form-control tm-minimal-input" id="FullName" name="FullName" required maxlength="100" autocomplete="name" placeholder="@Localizer["Contact_Name"]">
            </div>
            
            <div class="form-group mb-4">
              <input type="email" class="form-control tm-minimal-input" id="Email" name="Email" required maxlength="100" autocomplete="email" placeholder="@Localizer["Contact_Email"]">
            </div>
            
            <div class="form-group mb-4">
              <input type="text" class="form-control tm-minimal-input" id="Subject" name="Subject" maxlength="150" placeholder="@Localizer["Contact_Subject"]">
            </div>
            
            <div class="form-group mb-4">
              <textarea class="form-control tm-minimal-input" id="Message" name="Message" rows="4" required maxlength="2000" placeholder="@Localizer["Contact_Message"]"></textarea>
            </div>
            
            <button type="submit" class="btn btn-primary btn-block tm-btn-primary py-3 font-weight-bold text-uppercase w-100">@Localizer["Contact_Submit"]</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <footer class="text-center small tm-footer mt-5">
    <p class="mb-0 text-white">
      @Localizer["Footer_Copyright", DateTime.Now.Year]
    </p>
  </footer>
  <div class="tm-bg-overlay"></div>
</section>
