@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var phoneUrl = Configuration["SiteContact:PhoneUrl"];
    var whatsappUrl = Configuration["SiteContact:WhatsAppUrl"];
    var hasPhoneCta = !string.IsNullOrWhiteSpace(phoneUrl);
    var hasWhatsAppCta = !string.IsNullOrWhiteSpace(whatsappUrl);
    var showMobileCta = hasPhoneCta || hasWhatsAppCta;
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <meta name="description" content="@Localizer["Meta_Description"]" />
    <meta name="theme-color" content="#FAF6F0" />
    <meta name="mobile-web-app-capable" content="yes" />
    <title>@Localizer["Meta_Title"]</title>
    <link rel="icon" href="~/images/logo_assets/favicon-32.png" type="image/png" sizes="32x32" asp-append-version="true" />
    <link rel="icon" href="~/images/logo_assets/favicon-16.png" type="image/png" sizes="16x16" asp-append-version="true" />
    <link rel="icon" href="~/images/logo_assets/favicon.ico" type="image/x-icon" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/images/logo_assets/apple-touch-icon.png" sizes="180x180" asp-append-version="true" />
    <link rel="manifest" href="~/site.webmanifest" asp-append-version="true" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="preload" as="image" type="image/webp" href="~/images/products/dogal-ahsap-masa-hero.webp" asp-append-version="true" />

    <link rel="stylesheet" href="~/themes/infinite-loop/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/themes/infinite-loop/css/tooplate-infinite-loop.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ezgi-craft-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ezgi-craft-mobile.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/themes/infinite-loop/fontawesome-5.5/css/all.min.css" media="print" data-defer-css asp-append-version="true" />
    <link rel="stylesheet" href="~/themes/infinite-loop/slick/slick.css" media="print" data-defer-css asp-append-version="true" />
    <link rel="stylesheet" href="~/themes/infinite-loop/slick/slick-theme.css" media="print" data-defer-css asp-append-version="true" />
    <link rel="stylesheet" href="~/themes/infinite-loop/magnific-popup/magnific-popup.css" media="print" data-defer-css asp-append-version="true" />

    <script src="~/js/ezgi-early.js" asp-append-version="true"></script>
<!--
Tooplate 2117 Infinite Loop
https://www.tooplate.com/view/2117-infinite-loop
-->
    @await RenderSectionAsync("Styles", required: false)
  </head>
  <body class="@(showMobileCta ? "tm-has-mobile-cta" : null)">
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg tm-navbar" id="tmNav">
      <div class="container">
        <div class="tm-next">
            <a href="#infinite" class="navbar-brand" aria-label="@Localizer["Logo_Aria"]">
              <img src="~/images/logo_assets/logo_nav.png" alt="Ezgi Craft" class="navbar-brand-logo navbar-brand-logo--dark" width="356" height="120" asp-append-version="true" />
              <img src="~/images/logo_assets/logo_nav_white.png" alt="" class="navbar-brand-logo navbar-brand-logo--light" width="356" height="120" aria-hidden="true" asp-append-version="true" />
            </a>
        </div>

        <button class="navbar-toggler tm-mobile-menu-btn" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="@Localizer["Nav_Toggle"]">
          <span class="tm-hamburger" aria-hidden="true">
            <span class="tm-hamburger-line"></span>
            <span class="tm-hamburger-line"></span>
            <span class="tm-hamburger-line"></span>
          </span>
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
          <ul class="navbar-nav ml-auto">
            <li class="nav-item">
                <a class="nav-link tm-nav-link" href="#infinite">@Localizer["Nav_Home"]</a>
            </li>
            <li class="nav-item">
                <a class="nav-link tm-nav-link" href="#whatwedo">@Localizer["Nav_About"]</a>
            </li>
            <li class="nav-item">
              <a class="nav-link tm-nav-link" href="#testimonials">@Localizer["Nav_Values"]</a>
            </li>
            <li class="nav-item">
                <a class="nav-link tm-nav-link" href="#materials">@Localizer["Nav_Materials"]</a>
            </li>
            <li class="nav-item">
                <a class="nav-link tm-nav-link" href="#gallery">@Localizer["Nav_Gallery"]</a>
            </li>
            <li class="nav-item">
                <a class="nav-link tm-nav-link" href="#contact">@Localizer["Nav_Contact"]</a>
            </li>                    
            <li class="nav-item d-flex align-items-center justify-content-center tm-nav-tools">
                <partial name="_LanguageSwitcher" />
                <button id="themeToggle" class="theme-toggle-btn" title="@Localizer["ThemeToggle"]" aria-label="@Localizer["ThemeToggle"]">
                    <i class="fas fa-moon"></i>
                </button>
            </li>
          </ul>
        </div>        
      </div>
    </nav>

    <!-- Hero section -->
    <section id="infinite" class="tm-hero-section text-white">
      <div class="tm-hero-overlay"></div>
      <div class="container h-100 d-flex align-items-center tm-hero-container">
        <div class="row w-100 align-items-center tm-hero-row">
          <div class="col-lg-8 mx-auto text-center tm-hero-content">
            <span class="tm-hero-badge mb-3 d-inline-block">@Localizer["Hero_Header"]</span>
            <h1 class="tm-hero-title mb-4">@Localizer["Hero_Title"]</h1>
            <p class="tm-hero-subtitle mb-5">
              @Localizer["Hero_Subtitle"]
            </p>
            <div class="tm-hero-buttons">
              <a href="#gallery" class="btn tm-btn-primary tm-hero-btn">@Localizer["Hero_FirstButton"]</a>
              <a href="#contact" class="btn btn-outline-light tm-hero-btn tm-hero-btn-outline">@Localizer["Hero_SecondButton"]</a>
            </div>
          </div>
        </div>
      </div>
      <div class="tm-scroll-down-indicator">
        <a href="#whatwedo" class="tm-scroll-down-link" aria-label="@Localizer["ScrollDown"]">
          <span class="tm-scroll-down-mouse">
            <span class="tm-scroll-down-wheel"></span>
          </span>
        </a>
      </div>      
    </section>

    @RenderBody()

    @if (showMobileCta)
    {
      <nav class="tm-mobile-cta" aria-label="@Localizer["MobileCta_Label"]">
        @if (hasPhoneCta)
        {
          <a class="tm-mobile-cta-btn tm-mobile-cta-btn--primary" href="@phoneUrl">
            <i class="fas fa-phone" aria-hidden="true"></i>
            <span>@Localizer["MobileCta_Call"]</span>
          </a>
        }
        @if (hasWhatsAppCta)
        {
          <a class="tm-mobile-cta-btn @(hasPhoneCta ? "tm-mobile-cta-btn--secondary" : "tm-mobile-cta-btn--primary")" href="@whatsappUrl" target="_blank" rel="nofollow noopener noreferrer">
            <i class="fab fa-whatsapp" aria-hidden="true"></i>
            <span>@Localizer["MobileCta_WhatsApp"]</span>
          </a>
        }
        else
        {
          <a class="tm-mobile-cta-btn tm-mobile-cta-btn--secondary" href="#contact">
            <i class="far fa-envelope" aria-hidden="true"></i>
            <span>@Localizer["MobileCta_Message"]</span>
          </a>
        }
      </nav>
    }

    <script src="~/themes/infinite-loop/js/jquery-1.9.1.min.js" defer></script>
    <script src="~/themes/infinite-loop/slick/slick.min.js" defer></script>
    <script src="~/themes/infinite-loop/magnific-popup/jquery.magnific-popup.min.js" defer></script>
    <script src="~/themes/infinite-loop/js/easing.min.js" defer></script>
    <script src="~/themes/infinite-loop/js/jquery.singlePageNav.min.js" defer></script>
    <script src="~/themes/infinite-loop/js/bootstrap.min.js" defer></script>
    <script src="~/js/infinite-loop-site.js" defer asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
  </body>
</html>
