@using System.Globalization
@{
    var isTurkish = string.Equals(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, "tr", StringComparison.OrdinalIgnoreCase);
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    if (string.IsNullOrWhiteSpace(returnUrl))
    {
        returnUrl = "/";
    }
}

<div class="lang-switcher" role="group" aria-label="@Localizer["Lang_Label"]">
    @if (isTurkish)
    {
        <span class="lang-switcher-link is-active" aria-current="true">TR</span>
    }
    else
    {
        <a class="lang-switcher-link"
           asp-controller="Culture"
           asp-action="Set"
           asp-route-culture="tr"
           asp-route-returnUrl="@returnUrl"
           hreflang="tr">TR</a>
    }
    <span class="lang-switcher-sep" aria-hidden="true">/</span>
    @if (isTurkish)
    {
        <a class="lang-switcher-link"
           asp-controller="Culture"
           asp-action="Set"
           asp-route-culture="en"
           asp-route-returnUrl="@returnUrl"
           hreflang="en">EN</a>
    }
    else
    {
        <span class="lang-switcher-link is-active" aria-current="true">EN</span>
    }
</div>
