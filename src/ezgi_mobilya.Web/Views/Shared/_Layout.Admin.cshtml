<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ezgi Craft Yönetim Paneli</title>
    <link rel="stylesheet" href="~/themes/infinite-loop/fontawesome-5.5/css/all.min.css" />
    <link rel="stylesheet" href="~/themes/infinite-loop/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/ezgi-craft-theme.css" />
    <script>
      (function() {
        var savedTheme = localStorage.getItem('ezgi-craft-theme') || 'light';
        document.documentElement.setAttribute('data-theme', savedTheme);
      })();
    </script>
    <style>
        body {
            background-color: var(--bg-primary);
            color: var(--text-primary);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .admin-sidebar {
            background-color: var(--bg-card);
            border-right: 1px solid var(--color-border);
            min-height: 100vh;
            padding: 30px 15px;
        }
        .admin-nav-link {
            color: var(--text-secondary);
            font-size: 1.1rem;
            padding: 12px 15px;
            display: block;
            border-radius: 6px;
            margin-bottom: 8px;
            text-decoration: none;
            transition: all var(--transition-speed);
        }
        .admin-nav-link:hover, .admin-nav-link.active {
            background-color: var(--color-primary);
            color: var(--text-white-fixed) !important;
            text-decoration: none;
            box-shadow: 0 4px 10px rgba(var(--color-primary-rgb), 0.2);
        }
        .admin-nav-link i {
            margin-right: 10px;
            width: 25px;
            text-align: center;
        }
        .admin-card {
            background-color: var(--bg-card);
            border: 1px solid var(--color-border);
            border-radius: 8px;
            padding: 25px;
            box-shadow: 0 4px 15px var(--shadow-color);
            margin-bottom: 30px;
            transition: all var(--transition-speed);
        }
        .admin-card:hover {
            box-shadow: 0 6px 20px var(--shadow-hover);
        }
        .stat-icon {
            font-size: 2.5rem;
            color: var(--color-primary);
        }
        .navbar-admin {
            background-color: var(--bg-card) !important;
            border-bottom: 1px solid var(--color-border);
            padding: 15px 30px;
        }
        .admin-table {
            background-color: var(--bg-card);
            color: var(--text-primary);
        }
        .admin-table th {
            border-top: none;
            border-bottom: 2px solid var(--color-border) !important;
            color: var(--color-primary);
            font-weight: 700;
        }
        .admin-table td {
            border-top: 1px solid var(--color-border);
            vertical-align: middle;
            color: var(--text-secondary);
        }
        /* Mode toggle overlay */
        .admin-theme-btn {
            background: none;
            border: none;
            color: var(--text-primary);
            cursor: pointer;
            font-size: 1.2rem;
            padding: 8px;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background-color: var(--bg-secondary);
            transition: all var(--transition-speed) ease;
        }
        .admin-theme-btn:hover {
            background-color: var(--color-primary);
            color: var(--text-white-fixed) !important;
        }
    </style>
</head>
<body>
    
    <!-- Top Admin Header -->
    <nav class="navbar navbar-expand-lg navbar-admin d-flex justify-content-between align-items-center">
        <a class="navbar-brand text-uppercase d-flex align-items-center" href="/Admin" style="color: var(--color-primary); font-weight: 800; font-size: 1.5rem; letter-spacing: 1px;">
            <i class="fas fa-hammer mr-2"></i> Ezgi Craft Panel
        </a>
        <div class="d-flex align-items-center">
            <button id="themeToggle" class="admin-theme-btn mr-3" title="Mod Değiştir">
                <i class="fas fa-moon"></i>
            </button>
            <a href="/" class="btn btn-outline-secondary btn-sm" target="_blank">
                <i class="fas fa-external-link-alt mr-1"></i> Siteye Git
            </a>
        </div>
    </nav>

    <div class="container-fluid flex-grow-1">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-3 col-lg-2 admin-sidebar">
                <nav class="nav flex-column">
                    <a href="/Admin" class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                        <i class="fas fa-chart-line"></i> Özet Panel
                    </a>
                    <a href="/Admin/SocialMedia" class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "SocialMedia" ? "active" : "")">
                        <i class="fab fa-instagram"></i> Sosyal Medya
                    </a>
                    <a href="/Admin/Products" class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Products" ? "active" : "")">
                        <i class="fas fa-boxes"></i> Ürünlerimiz
                    </a>
                    <a href="/Admin/Messages" class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Messages" ? "active" : "")">
                        <i class="fas fa-envelope"></i> Gelen Mesajlar
                    </a>
                </nav>
            </div>

            <!-- Content Area -->
            <main class="col-md-9 col-lg-10 p-4">
                @if (TempData["AdminSuccess"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle mr-2"></i> @TempData["AdminSuccess"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }
                @if (TempData["AdminError"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle mr-2"></i> @TempData["AdminError"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/themes/infinite-loop/js/jquery-1.9.1.min.js"></script>     
    <script src="~/themes/infinite-loop/js/bootstrap.min.js"></script> 
    <script>
        $(function() {
            var themeToggleBtn = document.getElementById('themeToggle');
            var themeIcon = themeToggleBtn.querySelector('i');
            
            function updateToggleIcon(theme) {
                if (theme === 'dark') {
                    themeIcon.className = 'fas fa-sun';
                } else {
                    themeIcon.className = 'fas fa-moon';
                }
            }
            
            var currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
            updateToggleIcon(currentTheme);
            
            themeToggleBtn.addEventListener('click', function() {
                var current = document.documentElement.getAttribute('data-theme') || 'light';
                var nextTheme = current === 'dark' ? 'light' : 'dark';
                
                document.documentElement.setAttribute('data-theme', nextTheme);
                localStorage.setItem('ezgi-craft-theme', nextTheme);
                updateToggleIcon(nextTheme);
            });
        });
    </script>
</body>
</html>
