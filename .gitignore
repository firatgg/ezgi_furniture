# Visual Studio / .NET Core
## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/
Log/
Logs/

# Visual Studio 2015 cache/options directory
.vs/

# MSTest test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.nunit
nunit-agent*.log
nunit-console*.log

# Visual Studio Code files
.vscode/

# Rider files
.idea/

# Cursor files
.cursor/

# Dotnet code coverage reports
coverage.cobertura.xml
coverage.xml

# Mac/Linux generated files
*.DS_Store
._*

# Files built by Visual Studio
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.pch
*.pdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*.log
*.vspscc
*.vssscc
.builds
*.pidb
*.log
*.scc

# Microsoft User Experience Virtualization (UE-V)
*~.sync.bak

# StyleCop
StyleCopReport.xml

# Cache files
*.cache
*.cache.cs

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Project files
*.csproj.user

# Publish files
*.pubxml
*.pubxml.user

# NuGet Packages
*.nupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# Swap the two lines above for the one below if you want to remove all packages!
# **/[Pp]ackages/*

# Windows thumbnail cache files
Thumbs.db

# Umbraco files
/App_Data/TEMP/
/App_Data/umbraco.config

# Personal DLLs
# *.dll
# *.exe

# App settings
appsettings.Development.json
.env
